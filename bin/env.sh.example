#!/usr/bin/env bash
# bin/env.sh.example -- per-machine environment overrides for toolbelt (macOS/Linux).
#
# Copy to bin/env.sh and uncomment/edit what you need.
# bin/env.sh is gitignored so each machine keeps its own settings.
#
# Precedence:
#   1. Environment variables already set in your shell.
#   2. Values set below (only if not already defined).
#   3. Built-in defaults inside each tool.

# ---- Python interpreter --------------------------------------------------
# export TOOLBELT_PYTHON="/usr/local/bin/python3.11"

# ---- Secrets directory ---------------------------------------------------
# Default: ~/.toolbelt
# export TOOLBELT_SECRETS="$HOME/.toolbelt"

# ---- Config file location ------------------------------------------------
# Default: $TOOLBELT_SECRETS/config.toml
# export TOOLBELT_CONFIG="$HOME/.toolbelt/config.toml"

# ---- Per-tool overrides (usually set in config.toml instead) --------------
# export TOOLBELT_GITLAB_URL="https://gitlab.example.com/api/v4"
# export TOOLBELT_GITLAB_PROJECT_ID="12345"
# export TOOLBELT_JIRA_URL="https://jira.example.com/rest/api/2"
# export TOOLBELT_CONF_HOST="https://confluence.example.com"
