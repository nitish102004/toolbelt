@echo off
rem bin\env.cmd.example -- per-machine environment overrides for toolbelt.
rem
rem Copy this file to bin\env.cmd (same directory) and uncomment / edit the
rem lines you need. bin\env.cmd is intentionally .gitignored so each machine
rem can have its own settings without polluting the repo.
rem
rem Every gl / jira / conf shim calls this file at startup if it exists.
rem Use it when `setx` is blocked by policy or you just prefer per-clone
rem settings over global environment variables.
rem
rem Precedence at runtime:
rem   1. Environment variables you already had set globally.
rem   2. Values set in this file (this file only sets vars that are not
rem      already defined -- change `set` to `set!` below if you want the
rem      file's values to win).
rem   3. Built-in defaults inside the tool.

rem ---- Python interpreter --------------------------------------------------
rem Point at a specific python.exe (recommended when `python` is not on PATH
rem or you want a specific venv). The shim will exit with a clear error if
rem this file does not exist.
rem   set "TOOLBELT_PYTHON=H:\venv311\Scripts\python.exe"

rem ---- Secrets directory ---------------------------------------------------
rem Where token files live. Default: %USERPROFILE%\.toolbelt
rem   set "TOOLBELT_SECRETS=H:\CORE_WORK\.secrets"

rem ---- Config file location ------------------------------------------------
rem Default: <TOOLBELT_SECRETS>\config.toml
rem   set "TOOLBELT_CONFIG=H:\CORE_WORK\my-toolbelt-config.toml"

rem ---- Per-tool overrides (rarely needed here; usually go in config.toml) --
rem   set "TOOLBELT_GITLAB_URL=https://gitlab.example.com/api/v4"
rem   set "TOOLBELT_JIRA_URL=https://jira.example.com/rest/api/2"
rem   set "TOOLBELT_CONF_HOST=https://confluence.example.com"

