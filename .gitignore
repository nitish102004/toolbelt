# Byte-compiled Python
__pycache__/
*.py[cod]
*$py.class

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Virtual envs (should live outside the repo)
.venv/
venv/
env/

# ---- Secrets: belt-and-braces --------------------------------------------
# Real credentials live *outside* this repo (see docs/ARCHITECTURE.md and
# INSTALL.md). Nothing matching the patterns below is ever tracked, even if
# a file is accidentally placed inside the repo tree.
.secrets/
.toolbelt/
*.token
*.pat
signoz.credentials
signoz.session
signoz.preprod.session
*.pem
*.key
.env
.env.*

# Per-machine shim overrides (see bin/env.cmd.example / bin/env.sh.example)
bin/env.cmd
bin/env.sh

# Local overrides / scratch
local.cmd
*.local.md
scratch/
tmp/
